diff -ruN a/gcc/config/cos.h b/gcc/config/cos.h
--- a/gcc/config/cos.h	1970-01-01 01:00:00.000000000 +0100
+++ b/gcc/config/cos.h	2026-10-22 15:31:34.288778803 +0100
@@ -0,0 +1,25 @@
+/* Target definitions for cOS, an x86-64 operating system written in C++.
+   Programs are static ELF executables that are linked against newlib. */
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()        \
+  do                                    \
+    {                                   \
+      builtin_define ("__cos__");       \
+      builtin_assert ("system=cos");    \
+    }                                   \
+  while (0)
+
+/* Programs start at _start in crt0.o, which the C library provides along with crti.o and crtn.o. */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt0.o%s crti.o%s crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+#undef LIB_SPEC
+#define LIB_SPEC "-lc"
+
+/* cOS has no dynamic linker, so every program is linked statically. */
+#undef LINK_SPEC
+#define LINK_SPEC "-static -z max-page-size=4096"
